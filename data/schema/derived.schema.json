{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DerivedScore",
  "description": "Published output of the scorer: season-level scores for one scope and rubric version.",
  "type": "object",
  "required": [
    "franchise",
    "snapshotDate",
    "rubricVersion",
    "scope",
    "scopeHash",
    "series"
  ],
  "properties": {
    "franchise": {
      "type": "string"
    },
    "franchiseName": {
      "type": "string"
    },
    "snapshotDate": {
      "type": "string"
    },
    "rubricVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "scopeHash": {
      "type": "string"
    },
    "unmeasured": {
      "type": "object",
      "description": "Works with no measurement at all: absent from the chart rather than plotted at zero, with the tally per series so the absence is visible",
      "properties": {
        "works": {
          "type": "integer",
          "minimum": 0
        },
        "of": {
          "type": "integer",
          "minimum": 0
        },
        "minWords": {
          "type": "integer",
          "minimum": 0
        },
        "bySeries": {
          "type": "object"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "categories",
        "sources",
        "series"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "seasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "series",
              "film"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "serial",
              "series",
              "film"
            ],
            "description": "What one work in this series is: a serial for grouped classic-era runtimes"
          },
          "color": {
            "type": "string"
          },
          "ageRating": {
            "type": "integer"
          },
          "entityCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Curated Fi entities for this series; 0 means Fi is lexicon-only here"
          },
          "textBasis": {
            "type": "object",
            "description": "How much source text each work rests on: episodes, the validity floor in words, and per source how many episodes were covered, the median words, and how many were long enough to be measured",
            "properties": {
              "episodes": {
                "type": "integer",
                "minimum": 0
              },
              "minWords": {
                "type": "integer",
                "minimum": 0
              },
              "sources": {
                "type": "object"
              }
            }
          },
          "seasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "season",
                "episodeCount"
              ],
              "properties": {
                "season": {
                  "type": "integer",
                  "minimum": 1
                },
                "year": {
                  "type": "integer"
                },
                "yearEnd": {
                  "type": "integer"
                },
                "episodeCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "partCount": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Original transmission parts across the season's serials, when grouped"
                }
              }
            }
          }
        }
      }
    }
  }
}
