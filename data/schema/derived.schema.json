{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DerivedScore",
  "description": "Published output of the scorer: season-level scores for one scope and rubric version.",
  "type": "object",
  "required": ["franchise", "snapshotDate", "rubricVersion", "scope", "scopeHash", "series"],
  "properties": {
    "franchise": { "type": "string" },
    "franchiseName": { "type": "string" },
    "snapshotDate": { "type": "string" },
    "rubricVersion": { "type": "string" },
    "generatedAt": { "type": "string" },
    "scopeHash": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["categories", "sources", "series"],
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "series": { "type": "array", "items": { "type": "string" } }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "seasons"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "short": { "type": "string" },
          "kind": { "type": "string", "enum": ["series", "film"] },
          "color": { "type": "string" },
          "ageRating": { "type": "integer" },
          "entityCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Curated Fi entities for this series; 0 means Fi is lexicon-only here"
          },
          "textBasis": {
            "type": "object",
            "description": "How much source text each work rests on: episodes, and per source how many were covered and the median words",
            "properties": {
              "episodes": { "type": "integer", "minimum": 0 },
              "sources": { "type": "object" }
            }
          },
          "seasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["season", "episodeCount"],
              "properties": {
                "season": { "type": "integer", "minimum": 1 },
                "year": { "type": "integer" },
                "yearEnd": { "type": "integer" },
                "episodeCount": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
