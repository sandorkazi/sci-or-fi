{
  "version": "rubric-v1",
  "description": "Lexicon measurement layer. Scores each episode on two disjoint axes and aggregates to seasons.",
  "scale": {
    "min": 0,
    "max": 10,
    "mapping": "score = max * min(1, density / saturation)",
    "notes": "Density is hits per 1000 words. Saturation is the density at which the axis is considered fully expressed, declared here so scores are comparable across franchises. Raw density is always published alongside the score."
  },
  "axes": {
    "sci": {
      "label": "Sci - scientific / engineering rigour",
      "definition": "How much an episode's text turns on technical, scientific or engineering vocabulary, as opposed to being set dressing.",
      "subsignals": [
        {
          "id": "technical-lexicon-density",
          "coder": "lexicon",
          "weight": 1.0,
          "saturation": 20.0,
          "calibration": "p95 of episode-level density across the reference corpus",
          "patterns": [
            "sensor",
            "scanner",
            "scan",
            "detector",
            "probe",
            "telemetry",
            "diagnostic",
            "analysis",
            "analyze",
            "instrument",
            "experiment",
            "hypothesis",
            "theory",
            "calculation",
            "measurement",
            "equation",
            "formula",
            "physics",
            "chemistry",
            "biology",
            "biological",
            "astronomy",
            "geology",
            "engineer",
            "engineering",
            "repair",
            "circuit",
            "component",
            "computer",
            "program",
            "subroutine",
            "algorithm",
            "database",
            "radiation",
            "frequency",
            "modulation",
            "subspace",
            "tachyon",
            "particle",
            "warp",
            "dilithium",
            "antimatter",
            "reactor",
            "plasma",
            "orbit",
            "gravity",
            "gravitational",
            "magnetic",
            "atmosphere",
            "temperature",
            "pressure",
            "virus",
            "bacteria",
            "vaccine",
            "transporter",
            "phase",
            "polarity"
          ]
        }
      ]
    },
    "fi": {
      "label": "Fi - myth / magic / reality-bending",
      "definition": "How much an episode's text turns on god-like power, prophecy, magic-equivalent action or reality-breaking storytelling.",
      "subsignals": [
        {
          "id": "mythic-lexicon-density",
          "coder": "lexicon",
          "weight": 1.0,
          "saturation": 9.0,
          "calibration": "p95 of episode-level density across the reference corpus",
          "patterns": [
            "god",
            "gods",
            "goddess",
            "deity",
            "divine",
            "worship",
            "worshipper",
            "prayer",
            "temple",
            "altar",
            "ritual",
            "sacred",
            "holy",
            "prophet",
            "prophecy",
            "prophesy",
            "messiah",
            "oracle",
            "destiny",
            "fate",
            "immortal",
            "immortality",
            "eternal",
            "soul",
            "spirit",
            "spirits",
            "ghost",
            "afterlife",
            "heaven",
            "hell",
            "demon",
            "devil",
            "angel",
            "magic",
            "magical",
            "sorcery",
            "witch",
            "wizard",
            "spell",
            "curse",
            "supernatural",
            "miracle",
            "myth",
            "mythical",
            "legend",
            "psychic",
            "telepath",
            "telepathy",
            "telekinetic",
            "psionic",
            "possess",
            "possession",
            "reincarnation",
            "resurrection",
            "cult",
            "transcendent",
            "omnipotent",
            "illusion",
            "hallucination"
          ]
        }
      ]
    }
  },
  "uncertainty": {
    "method": "ci95-mean",
    "z": 1.96,
    "thinSampleBelow": 5,
    "thinSampleInflation": 1.5,
    "notes": "ci95 = z * stdev(episode scores) / sqrt(n), inflated when n is below thinSampleBelow. Measured from the episode distribution, never asserted by hand."
  },
  "reserved": {
    "notes": "Judgement sub-signals that require a coding coder (human or LLM) rather than a lexicon. Declared now so rubric-v2 is an extension, not a rewrite.",
    "sci": ["resolution-mechanism", "methodological-framing", "internal-consistency", "pseudoscience-handwave"],
    "fi": ["numinous-entity", "prophecy-driven-plot", "magic-equivalent-action", "reality-or-format-bending", "literal-afterlife", "absurdist-tonal-break"]
  },
  "scope": {
    "categories": ["plot-summary"],
    "sources": ["tvmaze", "wikipedia"]
  }
}
